generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model PUser {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  phone String? @unique
  eves  Eve[]
}

model Eve {
  id        Int    @id @default(autoincrement())
  color     String
  price     Float
  autonomie Int
  ownerId   Int
  owner     PUser  @relation(fields: [ownerId], references: [id])
}
